<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>_3FCompare.App</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 高 DPI：PerMonitorV2 按显示器 DPI 自适应（4K 250% 等缩放比例下正确渲染） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 版本号：默认 0.1.4-BETA；pack.ps1 用 -p:Version=X.Y.Z 覆盖时全链路生效。
         AssemblyVersion/FileVersion/InformationalVersion 均由 SDK 从 Version(+Suffix) 自动派生，
         不再硬编码（修复 0.1.2 发布时 exe 仍是 0.1.0-BETA 的版本错位）。 -->
    <Version>0.1.4</Version>
    <VersionSuffix>BETA</VersionSuffix>

    <!--
      NativeAOT 分发（已启用）：
      - PublishAot=true 输出原生单文件；.NET 11 preview 中 Native 编译隐含裁剪。
      - WinForms 裁剪在 preview 报 NETSDK1175；官方 SDK 提供 _SuppressWinFormsTrimError
        抑制开关（见 dotnet/sdk 的 GivenThatWeWantToPublishTrimmedWindowsFormsAndWPFApps 测试）。
      - JSON 已改源生成上下文（JsonAotContext / BookmarkJsonContext），无运行时反射。
    -->
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
    <!-- 官方支持的 WinForms 裁剪抑制开关（NETSDK1175） -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- 嵌入 FFF.Native.dll 实现单文件发布（完整版用；精简版发布时不包含此资源） -->
  <ItemGroup Condition="'$(EmbedFffNative)' == 'true'">
    <EmbeddedResource Include="..\..\third_party\fff_project\FFF.Native\x64\Release\FFF.Native.dll"
                      LogicalName="FFF.Native.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\3FCompare.Core\3FCompare.Core.csproj" />
  </ItemGroup>

</Project>