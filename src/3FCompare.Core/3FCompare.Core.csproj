<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>_3FCompare.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 版本号：与 App 保持一致，由 SDK 从 Version(+Suffix) 统一派生，
         pack.ps1 用 -p:Version=X.Y.Z 覆盖时全链路生效。
         不再硬编码 AssemblyVersion/FileVersion/InformationalVersion
         （避免 0.1.2 发布时程序集版本错位的同类问题）。 -->
    <Version>0.2.0</Version>
    <VersionSuffix>BETA</VersionSuffix>
  </PropertyGroup>

</Project>
