<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:_3FCompare.Localization"
        xmlns:ctrl="using:_3FCompare.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="_3FCompare.MainWindow"
        Title="{loc:Loc Win_Title}"
        Width="1600" Height="900" MinWidth="960" MinHeight="540"
        Background="{DynamicResource BgBrush}">

  <DockPanel>

    <!-- 菜单栏 -->
    <Menu DockPanel.Dock="Top" x:Name="MenuMain">
      <MenuItem Header="{loc:Loc Menu_File}">
        <MenuItem Header="{loc:Loc Menu_Open}" InputGesture="Ctrl+O" Click="OnOpenVideos" />
        <Separator />
        <MenuItem Header="{loc:Loc Menu_SaveSession}" Click="OnSaveSession" />
        <MenuItem Header="{loc:Loc Menu_LoadSession}" Click="OnLoadSession" />
        <MenuItem Header="{loc:Loc Menu_ExportFrame}" Click="OnExportFrame" />
        <Separator />
        <MenuItem Header="{loc:Loc Menu_Exit}" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="{loc:Loc Menu_View}" SubmenuOpened="OnViewMenuOpened">
        <!-- ══════ 视图模式：三态互斥，整列摆在菜单最上方 ══════
             这三项一直在，但埋在「对比模式」子菜单里、名字是"叠加 / 分屏 / 网格"，
             既看不出"它们是一组、可以互相切换"，也看不出切换后各自是什么 ——
             现在做成一列单选（ToggleType=Radio + GroupName 才画成圆点而非方勾，且同组自动互斥），
             并在右侧标出快捷键。勾选一律由 RefreshCompareModeChecks 按真实状态回写
             （框架会先改 IsChecked 再 RaiseClick，且菜单只是入口之一：G/V/S 与 C 循环都改状态）。
             同时撤下两个重复概念入口：「A-B 滑块视图」只画渐变占位、真机模式下会整块遮住真实画面，
             「显示 对比网格」实际动作是折叠侧栏（侧栏三态就在本菜单下方）。 -->
        <MenuItem Header="{loc:Loc Menu_ViewMode}" IsEnabled="False" />
        <MenuItem x:Name="MenuViewStandard" Header="{loc:Loc Menu_Mode_Standard}"
                  InputGesture="G" ToggleType="Radio" GroupName="ViewMode"
                  Click="OnCompareModePreset" Tag="grid" />
        <MenuItem x:Name="MenuViewAbSplit" Header="{loc:Loc Menu_Mode_AbDrag}"
                  InputGesture="V" ToggleType="Radio" GroupName="ViewMode"
                  Click="OnCompareModePreset" Tag="split" />
        <MenuItem x:Name="MenuViewWipe" Header="{loc:Loc Menu_Mode_Wipe}"
                  InputGesture="S" ToggleType="Radio" GroupName="ViewMode"
                  Click="OnCompareModePreset" Tag="overlay" />
        <Separator />
        <!-- 以下两项都只作用于「标准模式」那一格：单屏=只看选中路，网格布局=均匀格数预设。 -->
        <MenuItem Header="{loc:Loc Menu_ToggleSingle}" Click="OnToggleSingleMulti" />
        <MenuItem Header="{loc:Loc Menu_GridLayout}">
          <MenuItem Header="{loc:Loc Menu_Grid_2x1}" Click="OnGridPreset" Tag="2x1" />
          <MenuItem Header="{loc:Loc Menu_Grid_2x2}" Click="OnGridPreset" Tag="2x2" />
          <MenuItem Header="{loc:Loc Menu_Grid_3x3}" Click="OnGridPreset" Tag="3x3" />
          <MenuItem Header="{loc:Loc Menu_Grid_Auto}" Click="OnGridPreset" Tag="auto" />
        </MenuItem>
        <!-- 面板：聚合成子菜单，避免 8 个平铺项淹没主菜单（对齐 Premiere「窗口」/ VS Code「视图」分组） -->
        <MenuItem Header="{loc:Loc Menu_Panels}">
          <MenuItem Header="{loc:Loc Menu_Probe}" Click="OnToggleProbe" />
          <MenuItem Header="{loc:Loc Menu_Bookmarks}" Click="OnToggleBookmarks" />
          <MenuItem Header="{loc:Loc Menu_Offset}" Click="OnToggleOffset" />
          <MenuItem Header="{loc:Loc Menu_MediaInfo}" Click="OnToggleMediaInfo" />
          <MenuItem Header="{loc:Loc Menu_Diff}" Click="OnToggleDiff" />
          <MenuItem Header="{loc:Loc Menu_Audio}" Click="OnToggleAudio" />
        </MenuItem>
        <Separator />
        <!-- 对比模式下的辅助开关（docs/31 阶段 3）。三项"模式"本身已上移到菜单顶部的「视图模式」列，
             这里留下的都不是模式：互换/轮换只换"格 ↔ 路"的映射、不改变格数；
             自动进入对比是可勾选的偏好。故父项改名「对比选项」。
             AB 左右互换之所以不跟"左右拉动"共用一套判据：拉动靠窗口区域表达"露出哪一路"，互换会与揭示区打架。
             勾选刷新与"框架先取反再 RaiseClick"的坑见 RefreshCompareModeChecks。 -->
        <MenuItem x:Name="MenuCompareOptions" Header="{loc:Loc Menu_CompareOptions}"
                  SubmenuOpened="OnCompareModeMenuOpened">
          <MenuItem x:Name="MenuModeSwap" Header="{loc:Loc Menu_Mode_Swap}"
                    Click="OnSwapCompareCells" />
          <MenuItem x:Name="MenuModeRotate" Header="{loc:Loc Menu_Mode_Rotate}"
                    Click="OnRotateCompareCells" />
          <MenuItem x:Name="MenuAutoCompare" Header="{loc:Loc Menu_AutoCompare}"
                    ToggleType="CheckBox" Click="OnToggleAutoCompare" />
        </MenuItem>
        <Separator />
        <!-- 底部栏折叠（docs/31 阶段 4）：时间轴 / 状态栏，两项互相独立。
             两项都是"开/关"而非互斥选择，故用 ToggleType=CheckBox（上面「视图模式」那三项才是 Radio）。
             勾选刷新时机与"框架先取反再 RaiseClick"的坑见 RefreshBottomBarChecks 的注释。 -->
        <MenuItem x:Name="MenuTimeline" Header="{loc:Loc Menu_Timeline}"
                  ToggleType="CheckBox" Click="OnToggleBottomBar" Tag="timeline" />
        <MenuItem x:Name="MenuStatusBar" Header="{loc:Loc Menu_StatusBar}"
                  ToggleType="CheckBox" Click="OnToggleBottomBar" Tag="statusbar" />
        <!-- 悬浮传输栏（docs/31 阶段 4.3）：开启后传输栏改由 owned 顶层窗承载、鼠标靠近底边才浮现，
             常驻位让出的 54px 归视频区。默认关闭 = 既有常驻布局不变（见 AppSettings.FloatingTransport）。 -->
        <MenuItem x:Name="MenuFloatingTransport" Header="{loc:Loc Menu_FloatingTransport}"
                  ToggleType="CheckBox" Click="OnToggleBottomBar" Tag="floating" />
        <Separator />
        <!-- 工具侧栏三态：展开 / 图标栏 / 完全隐藏。
             三态互斥（单选语义），但沿用本菜单既有的 ToggleType=CheckBox + Click+Tag 写法 ——
             勾选一律由 RefreshSidebarChecks 按真实状态回写（框架会先取反再 RaiseClick）。
             旧版只有"展开/折叠"两态，完全隐藏只能靠拖分割条，且拖完不记忆（D1/D2）。 -->
        <MenuItem Header="{loc:Loc Menu_Sidebar}" SubmenuOpened="OnSidebarMenuOpened">
          <MenuItem x:Name="MenuSidebarExpanded" Header="{loc:Loc Menu_Sidebar_Expanded}"
                    ToggleType="CheckBox" Click="OnSidebarModePreset" Tag="expanded" />
          <MenuItem x:Name="MenuSidebarRail" Header="{loc:Loc Menu_Sidebar_Rail}"
                    ToggleType="CheckBox" Click="OnSidebarModePreset" Tag="rail" />
          <MenuItem x:Name="MenuSidebarHidden" Header="{loc:Loc Menu_Sidebar_Hidden}"
                    ToggleType="CheckBox" Click="OnSidebarModePreset" Tag="hidden" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Loc Menu_Fullscreen}" InputGesture="F11" Click="OnToggleFullscreen" />
      </MenuItem>
      <MenuItem Header="{loc:Loc Menu_Settings}">
        <MenuItem Header="{loc:Loc Menu_SettingsDialog}" Click="OnOpenSettings" />
      </MenuItem>
    </Menu>

    <!-- 底部：状态栏（DockPanel 反向堆叠，声明顺序 = 由下往上）
         视觉自下而上：状态栏 → 传输栏 → 时间轴 → 主区。
         主流播放器（PotPlayer / MPC-HC / VLC）均把 seek 条紧贴画面、按钮置于其下；
         原顺序（按钮在上、seek 条在下）与这一惯例相反，拖动时视线需跨过一行按钮。 -->
    <Border DockPanel.Dock="Bottom" x:Name="StatusBarHost" Height="24" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" x:Name="StatusEngine" Text="—"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock x:Name="StatusInfo" Text="—"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Right" x:Name="StatusView" Text=""
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                   VerticalAlignment="Center" Margin="16,0,0,0" />
      </DockPanel>
    </Border>

    <!-- 底部：传输栏（播放/步进/倍速/色彩/时间码） -->
    <Border DockPanel.Dock="Bottom" x:Name="TransportHost" Height="54"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

    <!-- 底部：时间轴（紧贴画面：刻度/播放头/A-B 区间） -->
    <Border DockPanel.Dock="Bottom" x:Name="TimelineHost" Height="40"
            Background="{DynamicResource CanvasDarkBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

    <!-- 主区：侧栏 | 分隔条 | 中央网格/放大镜 -->
    <Grid ColumnDefinitions="264,Auto,*" x:Name="MainArea">
      <ContentControl x:Name="SidebarHost" Grid.Column="0" />
      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4"
                    ResizeDirection="Columns" Background="{DynamicResource BorderBrush}" MinWidth="4" />
      <Panel Grid.Column="2" x:Name="CenterPanel">
        <ctrl:CompareGridView x:Name="Grid" DragDrop.AllowDrop="True" ClipToBounds="True" />
        <ctrl:MagnifierOverlay x:Name="Magnifier" />
      </Panel>
    </Grid>

  </DockPanel>
</Window>
