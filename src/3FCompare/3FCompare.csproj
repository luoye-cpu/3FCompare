<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>_3FCompare</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- NativeAOT 发布（M0 PoC-C 已验证；与 WinForms 版同规格） -->
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- 版本号：与 Core 保持一致，由 SDK 从 Version(+Suffix) 统一派生；
         pack.ps1 用 -p:Version=X.Y.Z 覆盖时全链路生效 -->
    <!-- ⚠ VersionSuffix 已移除（docs/45 P1-12）：0.2.5 是正式版本，带 -BETA 会让
         门禁与开发的 plain build 产出 "0.2.5-BETA"，与发布包（pack.ps1 传 -p:VersionSuffix=
         清空后为 "0.2.5"）不一致 ⇒ 同一份代码两个版本叙事。需要预发布时再加回来，
         并且必须同时让 pack.ps1 与门禁保持一致。 -->
    <Version>0.3.1-beta</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12：Diagnostics 暂不可用（不兼容 net11.0-windows），后续版本跟进 -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- PoC-A GDI 绘制 + ScreenFrameCapture 位图路径 -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引擎/Sync/设置/显示布局：UI 框架无关，直接复用 -->
    <ProjectReference Include="..\3FCompare.Core\3FCompare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 可测试性：抓屏胶水层（FrameCapture 的选路/回退/降级、WgcFrameCapture 的位图转换与释放）
         是 internal，且它的正确性只能靠替身驱动（真实 WGC 抓帧慢且依赖窗口）。
         仅对测试工程开放，不扩大对外 API 面。 -->
    <InternalsVisibleTo Include="3FCompare.Platform.Tests" />
  </ItemGroup>

  <!-- 嵌入 FFF.Native.dll 实现单文件发布（3FP 播放器内核，始终内嵌） -->
  <!-- P1-17：过去这里写死 x64\Release，与本项目的 $(Configuration) 完全脱钩，
       且内核目录被 .gitignore 忽略 —— 干净 clone 后会以一个不知所云的错误失败。
       现在：默认取 Release（发布产物应当是优化版内核），可用 -p:KernelConfiguration=Debug 覆盖；
       文件不存在时给出可执行指引而不是让构建蒙头往下走。 -->
  <PropertyGroup>
    <KernelConfiguration Condition="'$(KernelConfiguration)' == ''">Release</KernelConfiguration>
    <KernelDllPath>$(MSBuildThisFileDirectory)..\..\third_party\fff_project\FFF.Native\x64\$(KernelConfiguration)\FFF.Native.dll</KernelDllPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(KernelDllPath)" LogicalName="FFF.Native.dll" Condition="Exists('$(KernelDllPath)')" />
  </ItemGroup>

  <Target Name="CheckKernelDll" BeforeTargets="Build;Publish">
    <Error Condition="!Exists('$(KernelDllPath)')"
           Text="未找到内核 FFF.Native.dll（期望路径: $(KernelDllPath)）。请先运行 tools/构建全部.ps1 -Configuration $(KernelConfiguration) 构建并部署内核；若内核是用其它配置构建的，给本命令加 -p:KernelConfiguration=&lt;配置&gt;。" />
  </Target>

  <!-- 嵌入 SkiaSharp 与 HarfBuzzSharp 原生 DLL，实现单文件发布。
       版本目录用通配符而不是写死：Avalonia 升版会改变 resolved 版本，
       写死的话路径静默失效、嵌入资源缺失，而 Program.cs 的解压失败又被 catch 吞掉
       ⇒ 构建与 pack 自检全绿、用户启动即崩（docs/14 §2.2）。
       再配一个 CheckNativeGraphicsDlls 在 Build/Publish 前卡住，避免静默缺失。 -->
  <!-- 这两个版本由 **Avalonia 的传递依赖** 决定，本工程并不直接 PackageReference 它们，
       所以无法用包引用属性做单一真源。曾考虑用通配符匹配版本目录，但本机 NuGet 缓存里
       同时存在多个版本（2.88.9 / 3.119.0 / 3.119.4），通配会导致同一 LogicalName 重复嵌入
       而报 CS1508。故保留显式版本 + 缺失即报错：升级 Avalonia 后若 resolved 版本变了，
       构建会明确失败并提示如何覆盖，而不是"嵌入静默缺失、用户启动才崩"（docs/14 §2.2）。 -->
  <PropertyGroup>
    <SkiaSharpNativeVersion Condition="'$(SkiaSharpNativeVersion)' == ''">3.119.4</SkiaSharpNativeVersion>
    <HarfBuzzNativeVersion Condition="'$(HarfBuzzNativeVersion)' == ''">8.3.1.3</HarfBuzzNativeVersion>
    <_SkiaNativePath>$(NuGetPackageRoot)skiasharp.nativeassets.win32\$(SkiaSharpNativeVersion)\runtimes\win-x64\native\libSkiaSharp.dll</_SkiaNativePath>
    <_HarfBuzzNativePath>$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\$(HarfBuzzNativeVersion)\runtimes\win-x64\native\libHarfBuzzSharp.dll</_HarfBuzzNativePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(NuGetPackageRoot)' != ''">
    <EmbeddedResource Include="$(_SkiaNativePath)" LogicalName="libSkiaSharp.dll" Condition="Exists('$(_SkiaNativePath)')" />
    <EmbeddedResource Include="$(_HarfBuzzNativePath)" LogicalName="libHarfBuzzSharp.dll" Condition="Exists('$(_HarfBuzzNativePath)')" />
  </ItemGroup>

  <Target Name="CheckNativeGraphicsDlls" BeforeTargets="Build;Publish" Condition="'$(NuGetPackageRoot)' != ''">
    <Error Condition="!Exists('$(_SkiaNativePath)')"
           Text="未找到 SkiaSharp 原生库 libSkiaSharp.dll（期望: $(_SkiaNativePath)）。它由 Avalonia 传递引入，升级 Avalonia 后版本可能变化；请用 -p:SkiaSharpNativeVersion=&lt;实际版本&gt; 覆盖（可用版本见 $(NuGetPackageRoot)skiasharp.nativeassets.win32\ 下的目录名）。" />
    <Error Condition="!Exists('$(_HarfBuzzNativePath)')"
           Text="未找到 HarfBuzzSharp 原生库 libHarfBuzzSharp.dll（期望: $(_HarfBuzzNativePath)）。它由 Avalonia 传递引入；请用 -p:HarfBuzzNativeVersion=&lt;实际版本&gt; 覆盖（可用版本见 $(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\ 下的目录名）。" />
  </Target>

  <!-- 嵌入 3FC.WgcCapture.dll（抓屏主线路的原生 WGC 库，docs/27 §九 阶段 3） -->
  <!-- 与内核同款：路径由 PropertyGroup 定义、可用 -p:WgcCaptureDllPath=<绝对路径> 覆盖。
       注意这里**没有 Debug/Release 配置维度**：build.sh 直接把产物落在 native/wgc_capture/
       根目录，不像内核那样按配置分子目录（所以不引入会被静默忽略的 *Configuration 开关）。

       缺失时**降级为 Warning**（不再硬失败）的理由：该 DLL 被 native/wgc_capture/.gitignore 忽略、
       仓库内也没有可还原的基线归档（内核有 .3fc_kernel_baseline.bundle，WGC 没有），
       于是任何没有 VS C++ 工具链 + cppwinrt 头的机器（CI、新克隆）连 dotnet build / dotnet test
       都跑不起来 —— 而运行时 FrameCapture.GetProbe() 探测到缺库已有 GDI 兜底、本就不会崩。
       用构建失败去拦一个运行时不崩、且多数机器上根本修不了的条件，代价明显大于收益。
       需要严格把关的场合（发布/CI 门禁）用 -p:WgcCaptureRequired=true 强制缺失即 Error。 -->
  <PropertyGroup>
    <WgcCaptureDllPath Condition="'$(WgcCaptureDllPath)' == ''">$(MSBuildThisFileDirectory)..\..\native\wgc_capture\3FC.WgcCapture.dll</WgcCaptureDllPath>
    <WgcCaptureRequired Condition="'$(WgcCaptureRequired)' == ''">false</WgcCaptureRequired>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(WgcCaptureDllPath)" LogicalName="3FC.WgcCapture.dll" Condition="Exists('$(WgcCaptureDllPath)')" />
  </ItemGroup>

  <Target Name="CheckWgcCaptureDll" BeforeTargets="Build;Publish">
    <Error Condition="!Exists('$(WgcCaptureDllPath)') AND '$(WgcCaptureRequired)' == 'true'"
           Text="[WgcCaptureRequired=true] 未找到 WGC 抓屏原生库 3FC.WgcCapture.dll（期望路径: $(WgcCaptureDllPath)）。请在 Git Bash 中运行 native/wgc_capture/build.sh 构建（需 Visual Studio 的「使用 C++ 的桌面开发」负载，含 Windows SDK 的 cppwinrt 头）；若产物在别处，加 -p:WgcCaptureDllPath=&lt;绝对路径&gt;。" />

    <Warning Condition="!Exists('$(WgcCaptureDllPath)') AND '$(WgcCaptureRequired)' != 'true'"
             Text="⚠ 未找到 WGC 抓屏原生库 3FC.WgcCapture.dll（期望路径: $(WgcCaptureDllPath)）—— 本次构建**不会**嵌入它，运行时抓屏会全程退回 GDI 兜底（对 D3D flip-model 不可靠、窗口被遮挡时会抓到遮挡物，docs/26 §3.2）。要拿到完整功能，请在 Git Bash 中运行 native/wgc_capture/build.sh 构建（需 Visual Studio 的「使用 C++ 的桌面开发」负载，含 Windows SDK 的 cppwinrt 头）。发布/CI 请加 -p:WgcCaptureRequired=true 让本项缺失变成错误。" />

    <!-- S3：DLL 只查 Exists 不查新旧 ⇒ 改了 wgc_capture.cpp/.h 忘跑 build.sh 会**静默嵌入旧 DLL**
         （构建全绿，但原生行为与源码对不上，排查成本极高）。这里比对修改时间，旧了直接报错。
         ⚠ 这一条**不**跟随 WgcCaptureRequired 开关：它拦的是"本机源码与产物自相矛盾"，
         与"有没有 C++ 工具链"无关（DLL 不存在时下面两条都不成立，自然跳过）。
         只比对 DLL 真正的源文件（.cpp/.h）；selftest.cpp 只影响自测程序，不参与本嵌入。 -->
    <PropertyGroup Condition="Exists('$(WgcCaptureDllPath)')">
      <_WgcCaptureDllAbs>$([MSBuild]::NormalizePath('$(WgcCaptureDllPath)'))</_WgcCaptureDllAbs>
      <_WgcCaptureCppAbs>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\native\wgc_capture\wgc_capture.cpp'))</_WgcCaptureCppAbs>
      <_WgcCaptureHAbs>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\native\wgc_capture\wgc_capture.h'))</_WgcCaptureHAbs>
      <_WgcCaptureDllTicks>$([System.IO.File]::GetLastWriteTimeUtc('$(_WgcCaptureDllAbs)').Ticks)</_WgcCaptureDllTicks>
    </PropertyGroup>
    <Error Condition="Exists('$(_WgcCaptureDllAbs)') AND Exists('$(_WgcCaptureCppAbs)') AND $([System.IO.File]::GetLastWriteTimeUtc('$(_WgcCaptureCppAbs)').Ticks) &gt; $(_WgcCaptureDllTicks)"
           Text="3FC.WgcCapture.dll 比原生源文件 wgc_capture.cpp 旧 —— 改了原生代码后必须重新构建，否则会静默嵌入旧 DLL（构建全绿但行为对不上）。请在 Git Bash 中运行 native/wgc_capture/build.sh（或 tools/构建全部.ps1）。" />
    <Error Condition="Exists('$(_WgcCaptureDllAbs)') AND Exists('$(_WgcCaptureHAbs)') AND $([System.IO.File]::GetLastWriteTimeUtc('$(_WgcCaptureHAbs)').Ticks) &gt; $(_WgcCaptureDllTicks)"
           Text="3FC.WgcCapture.dll 比原生源文件 wgc_capture.h 旧 —— 改了原生代码后必须重新构建，否则会静默嵌入旧 DLL（构建全绿但行为对不上）。请在 Git Bash 中运行 native/wgc_capture/build.sh（或 tools/构建全部.ps1）。" />
  </Target>

  <!-- 构建期生成源码指纹（docs/49 切片 1 的 2b）：
       mtime 判据只能说"有东西比产物新"，内容指纹能说"是哪个文件没进这次构建"。
       逻辑放在 tools/源码指纹.ps1 —— MSBuild 里做不动：Include 属性值结尾的 `;` 被当列表分隔符
       吃掉（写成 &#59; 同样被吃），%(Hash) 在 ->变换 里展开成空串，两条都在本机实测踩过。
       产物两个：
         ① obj/.../SourceFingerprint.cs —— 编进程序集，供日志 [产物] 行打短摘要
         ② 输出目录 source-fingerprint.txt —— 供 tools/验证守卫.ps1 -Fingerprint 逐项比对
       ⚠ 覆盖面 = 本工程自身的 .cs/.axaml；Core / native / 内核 DLL 由验证守卫的 mtime 逐类别兜。 -->
  <Target Name="GenerateSourceFingerprint" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <!-- ⚠ 别在单引号包裹的 XML 属性里写 '\'（TrimEnd('\') 那种）：属性会被截断成非法 XML。
           目录规范化统一交给 NormalizePath / GetFullPath。 -->
      <_FpScript>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\..\..\tools\源码指纹.ps1'))</_FpScript>
      <_FpProjDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)'))</_FpProjDir>
      <_FpOutCs>$([System.IO.Path]::GetFullPath('$(_FpProjDir)\$(IntermediateOutputPath)SourceFingerprint.cs'))</_FpOutCs>
      <_FpRooted>$([System.IO.Path]::IsPathRooted('$(TargetDir)'))</_FpRooted>
      <_FpOutTxt Condition=" '$(_FpRooted)' == 'True' ">$([System.IO.Path]::GetFullPath('$(TargetDir)source-fingerprint.txt'))</_FpOutTxt>
      <_FpOutTxt Condition=" '$(_FpRooted)' != 'True' ">$([System.IO.Path]::GetFullPath('$(_FpProjDir)\$(TargetDir)source-fingerprint.txt'))</_FpOutTxt>
    </PropertyGroup>
    <Exec Condition="Exists('$(_FpScript)')"
          Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(_FpScript)" -ProjectDir "$(_FpProjDir)" -OutCs "$(_FpOutCs)" -OutTxt "$(_FpOutTxt)"'
          StandardOutputImportance="low" IgnoreExitCode="true" />
    <Error Condition="!Exists('$(_FpScript)')"
           Text="缺少 tools\源码指纹.ps1 —— 宁可编不过，也不产出一份没有身份的二进制（docs/49 切片 1）。" />
    <!-- fail-closed：脚本跑了却没产出 .cs 也算构建错误，不允许"没指纹但编过了" -->
    <Error Condition="Exists('$(_FpScript)') And !Exists('$(_FpOutCs)')"
           Text="源码指纹未生成（$(_FpOutCs) 不存在）—— tools\源码指纹.ps1 执行失败。宁可编不过，也不要一份没有身份的二进制。" />
    <ItemGroup>
      <Compile Include="$(_FpOutCs)" Condition="Exists('$(_FpOutCs)')" />
    </ItemGroup>
  </Target>

  <!-- 本地化字符串与窗口帧捕获（自 App 项目迁入；命名空间保持 _3FCompare.App[.Capture] 不变以零改动引用） -->

  <!-- 发布后删除多余的 DLL（已内嵌到 exe，无需单独分发） -->
  <Target Name="RemoveUnusedNativeDlls" AfterTargets="Publish">
    <Delete Files="$(PublishDir)av_libglesv2.dll" Condition="Exists('$(PublishDir)av_libglesv2.dll')" />
    <Delete Files="$(PublishDir)libSkiaSharp.dll" Condition="Exists('$(PublishDir)libSkiaSharp.dll')" />
    <Delete Files="$(PublishDir)libHarfBuzzSharp.dll" Condition="Exists('$(PublishDir)libHarfBuzzSharp.dll')" />
  </Target>

</Project>
