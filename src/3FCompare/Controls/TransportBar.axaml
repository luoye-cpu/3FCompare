<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="54"
             x:Class="_3FCompare.Controls.TransportBar">

  <Grid ColumnDefinitions="*,Auto,*" Margin="12,7">
    <!-- 图标不用字形（会因字体缺字渲染成豆腐块），改由 AppIcons 在构造时装配矢量几何 -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
      <Button x:Name="BtnAdd" Width="36" Height="36" Click="OnAdd" />
      <Button x:Name="BtnRemove" Width="36" Height="36" Click="OnRemove" />
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
      <Button x:Name="BtnSecPrev" Width="40" Height="36" Click="OnSecPrev" />
      <Button x:Name="BtnFramePrev" Width="38" Height="36" Click="OnFramePrev" />
      <Button x:Name="BtnPlayPause" Width="46" Height="36" Click="OnPlayPause" />
      <Button x:Name="BtnStop" Width="38" Height="36" Click="OnStop" />
      <Button x:Name="BtnFrameNext" Width="38" Height="36" Click="OnFrameNext" />
      <Button x:Name="BtnSecNext" Width="40" Height="36" Click="OnSecNext" />
      <Button x:Name="BtnLoop" Width="40" Height="36" Click="OnLoop" />
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <ComboBox x:Name="ComboSpeed" Width="82" Height="36" FontSize="13"
                SelectionChanged="OnSpeedChanged" />
      <ComboBox x:Name="ComboColorMode" Width="172" Height="36" FontSize="13"
                SelectionChanged="OnColorModeChanged" />
      <TextBlock x:Name="TextTime" Width="168" Margin="10,0,0,0" VerticalAlignment="Center"
                 HorizontalAlignment="Right" TextAlignment="Right" FontFamily="Consolas" FontSize="13"
                 Foreground="{DynamicResource TextSecondaryBrush}" Text="00:00:00:00 / 00:00:00" />
      <TextBlock x:Name="TextInfo" MaxWidth="120" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="" />
    </StackPanel>
  </Grid>
</UserControl>
