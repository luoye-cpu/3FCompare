<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>_3FCompare.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- NativeAOT 发布（M0 PoC-C 已验证；与 WinForms 版同规格） -->
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 钉住同一版本，避免 11.3.* 浮动解析导致各包版本漂移 -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- PoC-A GDI 绘制 + M4 WgcFrameCapture 位图路径 -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引擎/Sync/设置/显示布局：UI 框架无关，直接复用 -->
    <ProjectReference Include="..\3FCompare.Core\3FCompare.Core.csproj" />
  </ItemGroup>

  <!-- 嵌入 FFF.Native.dll 实现单文件发布（完整版用；精简版发布时不包含此资源） -->
  <ItemGroup Condition="'$(EmbedFffNative)' == 'true'">
    <EmbeddedResource Include="..\..\third_party\fff_project\FFF.Native\x64\Release\FFF.Native.dll"
                      LogicalName="FFF.Native.dll" />
  </ItemGroup>

  <!-- 双轨共享：本地化字符串单一事实源（迁移期间链接编译，M5 切换时移入本项目） -->
  <ItemGroup>
    <Compile Include="..\3FCompare.App\Utils\LanguageManager.cs" Link="Localization\LanguageManager.cs" />
    <!-- 纯 Win32 GDI 帧捕获（与 UI 框架无关，链接复用） -->
    <Compile Include="..\3FCompare.App\Capture\WgcFrameCapture.cs" Link="Platform\WgcFrameCapture.cs" />
  </ItemGroup>

</Project>
