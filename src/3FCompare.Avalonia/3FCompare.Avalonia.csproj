<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>_3FCompare.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- NativeAOT 发布（M0 PoC-C 验证项；与 WinForms 版同规格） -->
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.*" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- M0 PoC：直接复用 Core 层（引擎/Sync），验证 NativeControlHost 承载真实引擎 -->
    <ProjectReference Include="..\3FCompare.Core\3FCompare.Core.csproj" />
  </ItemGroup>

</Project>
