+void PlayerVideoRenderer::NotePumpPresentDuration(
+    const std::chrono::steady_clock::duration elapsed) noexcept {
+    // Threshold = 100 ms, i.e. several frame periods (~6 frames at 60 Hz, ~24 at
+    // 240 Hz). A healthy Present is paced by the swap chain's vblank wait, so it
+    // lands well under one frame period; anything in the 100 ms range is either
+    // a stall or a first-frame setup cost, and both are worth a line. The worst
+    // value is kept unconditionally so a later investigation can see how close
+    // the healthy path runs to the threshold.
+    constexpr auto slowPresentThreshold = std::chrono::milliseconds(100);
+    const auto elapsed100ns = static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count() / 100);
+    auto worst = pumpPresentMax100ns_.load(std::memory_order_relaxed);
+    while (elapsed100ns > worst && !pumpPresentMax100ns_.compare_exchange_weak(
+            worst, elapsed100ns, std::memory_order_relaxed)) {}
+    if (elapsed < slowPresentThreshold) return;
+    // Counted unconditionally; only the line is cooldown-suppressed.
+    const auto overCount = pumpSlowPresentCount_.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (!ObservabilityLogAllowed(pumpSlowPresentLogAt_)) return;
+    // Fixed-size stack buffer: this runs on the pump thread inside a noexcept
+    // function, so a std::string/std::to_string allocation here could turn an
+    // OutOfMemory into std::terminate.
+    char line[224]{};
+    _snprintf_s(line, sizeof(line), _TRUNCATE,
+        "FFF.Native: presenter pump slow Present window=%p elapsed=%.1fms max=%.1fms over=%llu",
+        static_cast<void*>(window_),
+        std::chrono::duration<double, std::milli>(elapsed).count(),
+        static_cast<double>(pumpPresentMax100ns_.load(std::memory_order_relaxed)) / 10000.0,
+        static_cast<unsigned long long>(overCount));
+    FFF3FP_KernelLogImpl(line);
+    OutputDebugStringA(line);
+}
+
+void PlayerVideoRenderer::NotePumpOwnedPresentExcluded(const char* reason) noexcept {
+    // docs/40: "only one thread in the process is inside Present" used to have
+    // exactly two exceptions — ClearSurface()'s Present(0, 0) on the caller
+    // thread and the handoff 2 s timeout fallback. Both are now *excluded*
+    // instead of performed, so this line reports a suppressed Present rather than
+    // an off-pump one (the former "off-pump Present ... reason=..." line no
+    // longer exists anywhere in the binary). The counters are bumped by the
+    // callers unconditionally; only this line is cooldown-suppressed, because
+    // ClearSurface repeats on every device rebuild and a wedged pump repeats on
+    // every boundary present.
+    if (!ObservabilityLogAllowed(offPumpPresentLogAt_)) return;
+    char line[224]{};
+    _snprintf_s(line, sizeof(line), _TRUNCATE,
+        "FFF.Native: pump-owned Present excluded window=%p reason=%s clearSurface=%llu handoffTimeout=%llu",
+        static_cast<void*>(window_), reason == nullptr ? "unknown" : reason,
+        static_cast<unsigned long long>(
+            offPumpClearSurfacePresents_.load(std::memory_order_relaxed)),
+        static_cast<unsigned long long>(
+            handoffTimeoutFallbacks_.load(std::memory_order_relaxed)));
+    FFF3FP_KernelLogImpl(line);
+    OutputDebugStringA(line);
+}
