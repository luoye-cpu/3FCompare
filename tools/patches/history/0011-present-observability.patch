+// 3FCompare (F-LOG): process log sink, defined in 3FP/Api/PlayerApi.cpp and
+// forwarded to the callback installed through FFF3FP_SetLogCallback. It is a
+// plain C++ symbol rather than FFF3FP_API, so using it adds nothing to the
+// exported surface (which must stay at 82 symbols / API version 15).
+void FFF3FP_KernelLogImpl(const char* utf8Line) noexcept;
+
+namespace {
+// Cooldown for the Present-observability lines. Without it a route that is slow
+// rather than hung emits one line per frame, and every line is written to disk
+// by the managed sink — that would drown logs/app-*.log and add I/O to the very
+// thread whose stall is being investigated.
+constexpr auto PresentObservabilityLogCooldown = std::chrono::seconds(10);
+
+// True (and arms the deadline) when the cooldown since the last line has
+// elapsed. Deadlines are steady_clock milliseconds since epoch, 0 = never.
+bool ObservabilityLogAllowed(std::atomic<std::int64_t>& deadline) noexcept {
+    const auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const auto previous = deadline.load(std::memory_order_acquire);
+    if (previous != 0 && nowMs - previous <
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            PresentObservabilityLogCooldown).count()) return false;
+    deadline.store(nowMs, std::memory_order_release);
+    return true;
+}
+}
