diff --git a/code/CMakeLists.txt b/code/CMakeLists.txt
index dd14e36..168a9ec 100755
--- a/code/CMakeLists.txt
+++ b/code/CMakeLists.txt
@@ -18,6 +18,54 @@ option(ENABLE_BUILD_CODECS "Build all codecs" ON)
 option(IAMF_TEST_TOOL "IAMF test tool" OFF)
 option(SUPPORT_VERIFIER "Output vlogging file" OFF)
 
+# ---------------------------------------------------------------------------
+# AAC decoding backend.
+#   fdk    : FDK-AAC (aac_multistream_decoder.c) - default, upstream behaviour.
+#            FDK-AAC is nonfree, so it cannot ship inside the product body.
+#   ffmpeg : FFmpeg's clean-room native "aac" decoder
+#            (aac_multistream_decoder_ffmpeg.c), same aac_multistream_decoder.h
+#            contract, so no other IAMF source file changes. Requires an
+#            FFmpeg development suite (headers + import libraries).
+# ---------------------------------------------------------------------------
+set(IAMF_AAC_BACKEND "fdk" CACHE STRING
+    "AAC decoding backend: fdk (FDK-AAC, nonfree) or ffmpeg (FFmpeg native aac, clean-room)")
+set_property(CACHE IAMF_AAC_BACKEND PROPERTY STRINGS fdk ffmpeg)
+
+if(NOT IAMF_AAC_BACKEND MATCHES "^(fdk|ffmpeg)$")
+    message(FATAL_ERROR "IAMF_AAC_BACKEND must be 'fdk' or 'ffmpeg', got '${IAMF_AAC_BACKEND}'")
+endif()
+
+if(IAMF_AAC_BACKEND STREQUAL "ffmpeg")
+    set(FFMPEG_INCLUDE_DIR "" CACHE PATH
+        "Directory holding libavcodec/libavutil headers (the FFmpeg include root)")
+    set(FFMPEG_LIBRARY_DIR "" CACHE PATH
+        "Directory holding the FFmpeg import libraries (avcodec/avutil)")
+
+    if(NOT EXISTS "${FFMPEG_INCLUDE_DIR}/libavcodec/avcodec.h")
+        message(FATAL_ERROR
+            "IAMF_AAC_BACKEND=ffmpeg needs -DFFMPEG_INCLUDE_DIR=<dir with libavcodec/avcodec.h>"
+            " (got '${FFMPEG_INCLUDE_DIR}')")
+    endif()
+
+    find_library(FFMPEG_AVCODEC_LIBRARY NAMES avcodec-63 avcodec-62 avcodec libavcodec
+                 PATHS "${FFMPEG_LIBRARY_DIR}" NO_DEFAULT_PATH)
+    find_library(FFMPEG_AVUTIL_LIBRARY NAMES avutil-61 avutil-60 avutil libavutil
+                 PATHS "${FFMPEG_LIBRARY_DIR}" NO_DEFAULT_PATH)
+    if(NOT FFMPEG_AVCODEC_LIBRARY OR NOT FFMPEG_AVUTIL_LIBRARY)
+        message(FATAL_ERROR
+            "IAMF_AAC_BACKEND=ffmpeg needs avcodec and avutil import libraries in "
+            "FFMPEG_LIBRARY_DIR='${FFMPEG_LIBRARY_DIR}'")
+    endif()
+
+    # iamf is a static library, so the FFmpeg link interface has to travel to
+    # every consumer (iamfdec, the product kernel).
+    set(IAMF_AAC_FFMPEG_LIBS "${FFMPEG_AVCODEC_LIBRARY};${FFMPEG_AVUTIL_LIBRARY}")
+    add_definitions(-DIAMF_AAC_BACKEND_FFMPEG=1)
+    message(STATUS "AAC backend: FFmpeg native 'aac' (${IAMF_AAC_FFMPEG_LIBS})")
+else()
+    message(STATUS "AAC backend: FDK-AAC")
+endif()
+
 if (SUPPORT_VERIFIER)
     message(STATUS "Output vlogging file")
     add_definitions(-DSUPPORT_VERIFIER=1)
@@ -47,11 +95,18 @@ else()
     endif()
 
     unset(find_aac CACHE)
-    find_library(find_aac NAMES fdk-aac PATHS ${DEP_CODECS_DIR}/lib NO_DEFAULT_PATH)
-    if(${find_aac} STREQUAL "find_aac-NOTFOUND")
-        message(STATUS "The aac library was not found")
-    else()
+    if(IAMF_AAC_BACKEND STREQUAL "ffmpeg")
+        # AAC support is still compiled in, on the FFmpeg backend: no fdk-aac
+        # library is looked up, linked or required.
         add_definitions(-DCONFIG_AAC_CODEC)
+        message(STATUS "The aac codec is provided by the FFmpeg backend")
+    else()
+        find_library(find_aac NAMES fdk-aac PATHS ${DEP_CODECS_DIR}/lib NO_DEFAULT_PATH)
+        if(${find_aac} STREQUAL "find_aac-NOTFOUND")
+            message(STATUS "The aac library was not found")
+        else()
+            add_definitions(-DCONFIG_AAC_CODEC)
+        endif()
     endif()
 
     unset(find_flac CACHE)
@@ -94,6 +149,10 @@ include_directories(
     ${PROJECT_SOURCE_DIR}/src/iamf_dec/obu
 )
 
+if(IAMF_AAC_BACKEND STREQUAL "ffmpeg")
+    include_directories("${FFMPEG_INCLUDE_DIR}")
+endif()
+
 link_directories (
     ${DEP_CODECS_DIR}/lib
 )
@@ -104,8 +163,13 @@ else()
     add_library(${PROJECT_NAME} STATIC ${sources})
 endif()
 if (ENABLE_BUILD_CODECS)
-    add_dependencies(${PROJECT_NAME} dep_opus dep_aac dep_flac)
-    target_link_libraries (${PROJECT_NAME} opus fdk-aac FLAC) 
+    if(IAMF_AAC_BACKEND STREQUAL "ffmpeg")
+        add_dependencies(${PROJECT_NAME} dep_opus dep_flac)
+        target_link_libraries (${PROJECT_NAME} opus FLAC)
+    else()
+        add_dependencies(${PROJECT_NAME} dep_opus dep_aac dep_flac)
+        target_link_libraries (${PROJECT_NAME} opus fdk-aac FLAC)
+    endif()
 else()
     if(NOT ${find_opus} STREQUAL "find_opus-NOTFOUND")
         target_link_libraries (${PROJECT_NAME} opus)
@@ -117,6 +181,9 @@ else()
         target_link_libraries (${PROJECT_NAME} FLAC)
     endif()
 endif()
+if(IAMF_AAC_BACKEND STREQUAL "ffmpeg")
+    target_link_libraries (${PROJECT_NAME} "${IAMF_AAC_FFMPEG_LIBS}")
+endif()
 if(NOT MSVC)
     target_link_libraries (${PROJECT_NAME} m)
 endif()
