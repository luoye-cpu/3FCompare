+/**
+ * @file aac_multistream_decoder_ffmpeg.c
+ * @brief AAC multistream decoder on FFmpeg's clean-room native AAC decoder.
+ *
+ * Drop-in replacement for aac_multistream_decoder.c (FDK-AAC based): it
+ * implements the same four entry points of aac_multistream_decoder.h, so
+ * iamf_aac_decoder.c and everything above it (core decoder, element
+ * reconstructor, renderer, binaural path) stay untouched.
+ *
+ * IAMF multistream semantics preserved (identical to the FDK backend):
+ *   - one decoder instance per IAMF audio substream - not one shared
+ *     "multistream" instance; the audio element's codec_config
+ *     AudioSpecificConfig is shared by all of its substreams;
+ *   - the first `coupled_streams` substreams carry a coupled pair (2 channels)
+ *     and are configured with the AudioSpecificConfig as signalled;
+ *   - the remaining `streams - coupled_streams` substreams carry one channel
+ *     each and are configured with a copy of the AudioSpecificConfig whose
+ *     channelConfiguration field is rewritten to 1;
+ *   - total channels of the audio element = streams + coupled_streams; the
+ *     planar output is filled substream by substream:
+ *       [s0 ch0 | s0 ch1] [s1 ch0 | s1 ch1] ... [sN ch0]
+ *
+ * Documented, bounded differences against the FDK backend:
+ *   - FFmpeg's native decoder emits float; samples are converted into the
+ *     16-bit planar buffer with round-to-nearest and saturation, which is the
+ *     same quantisation step the FDK backend delivers (FDK emits INT_PCM =
+ *     short here), so iamf_aac_decoder.c's /32768.f rescale stays valid.
+ *   - the reported decoder delay is the decoded frame length (1024 for
+ *     frameLengthFlag = 0), which is what CStreamInfo::outputDelay reports for
+ *     FDK AAC-LC; verified against the fdk backend in the A/B run.
+ *   - on flush FDK always returns a frame; FFmpeg returns whatever it still
+ *     has buffered (nothing for AAC-LC), so a silent frame is emitted to keep
+ *     the sample accounting identical.
+ **/
+
+#ifdef CONFIG_AAC_CODEC
+#ifdef IAMF_AAC_BACKEND_FFMPEG
+#include "aac_multistream_decoder.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* FFmpeg headers first, on purpose: clog.h defines function-like macros named
+ * error()/warning()/debug()/trace() that must not meet the FFmpeg headers. */
+#include <libavcodec/avcodec.h>
+#include <libavcodec/codec.h>
+#include <libavcodec/codec_id.h>
+#include <libavcodec/defs.h>
+#include <libavcodec/packet.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/error.h>
+#include <libavutil/frame.h>
+#include <libavutil/mem.h>
+#include <libavutil/samplefmt.h>
+
+#include "IAMF_defines.h"
+#include "clog.h"
+#include "iamf_private_definitions.h"
+#include "iamf_types.h"
+#include "iamf_utils.h"
+
+#ifdef def_log_tag
+#undef def_log_tag
+#endif
+
+#define def_log_tag "AACMSFF"
+
+/* The generic copy_channel_out callback works on a 16 bit planar buffer. */
+typedef short aac_pcm_sample_t;
+
+#define def_max_aac_buffer_size def_max_aac_frame_size * 2
+
+/* ISO/IEC 14496-3, Table 1.23: sampling_frequency_index -> rate. */
+static const int def_aac_sample_rates[13] = {
+    96000, 88200, 64000, 48000, 44100, 32000, 24000,
+    22050, 16000, 12000, 11025, 8000,  7350};
+
+struct AacMsDecoder {
+  uint32_t flags;
+  int streams;
+  int coupled_streams;
+  int delay;
+
+  AVCodecContext **avctx;
+  AVFrame *frame;
+  int probed;
+};
+
+typedef void (*func_aac_copy_channel_out_t)(void *dst, const void *src,
+                                            int frame_size, int channels);
+
+/* float [-1,1] -> 16 bit, round to nearest with saturation. */
+static aac_pcm_sample_t aac_float_to_short(float v) {
+  float scaled = v * 32768.0f;
+  if (scaled >= 32767.0f) return (aac_pcm_sample_t)32767;
+  if (scaled <= -32768.0f) return (aac_pcm_sample_t)-32768;
+  return (aac_pcm_sample_t)lrintf(scaled);
+}
+
+/* FFmpeg hands planar audio over AVFrame::data[c] - one pointer per plane -
+ * and the planes are NOT guaranteed to be spaced by linesize[0] (the AAC
+ * decoder's frames come out of a buffer allocator that aligns every plane, so
+ * for 1024 floats linesize[0] is 8192 bytes while plane 1 actually starts 8256
+ * bytes after plane 0). Reading plane c through data[0] + c * stride therefore
+ * returns the tail padding of the previous plane: that produced a correct
+ * channel 0 and a corrupt channel 1 for every coupled substream. Walk
+ * data[c] instead, which is the only documented contract. */
+static void aac_copy_frame_planes(aac_pcm_sample_t *dst, const AVFrame *frame,
+                                  int frame_size, int channels) {
+  for (int c = 0; c < channels; ++c) {
+    const float *plane = (const float *)frame->data[c];
+    for (int s = 0; s < frame_size; ++s) {
+      dst[(size_t)c * frame_size + s] = aac_float_to_short(plane[s]);
+    }
+  }
+}
+
+/* Rewrite channelConfiguration of an AudioSpecificConfig, exactly as the fdk
+ * backend does for its mono substreams. */
+static int aac_config_set_channels(uint8_t *conf, uint32_t size, int channels) {
+  int nbytes = 0;
+  uint8_t byte = 0;
+
+  // audioObjectType = 2 (5bits)
+  // samplingFrequencyIndex (4 or 28 bits)
+  // channelConfiguration (4 bits)
+  byte = conf[nbytes] & 0x7;
+  byte = byte << 1 | conf[++nbytes] >> 7;
+  if (byte == 0xf) nbytes += 3;
+  byte = ~(0xf << 3) & conf[nbytes];
+  byte = (channels & 0xf) << 3 | byte;
+  debug("%d byte 1 bit: 0x%x->0x%x", nbytes, conf[nbytes], byte);
+  if (nbytes < size)
+    conf[nbytes] = byte;
+  else
+    return IAMF_ERR_BAD_ARG;
+
+  return IAMF_OK;
+}
+
+/* Read audioObjectType / sampling_frequency_index / channel_configuration of a
+ * plain AAC-LC AudioSpecificConfig, so AVCodecContext can be seeded with the
+ * same configuration the fdk backend derives from it. */
+static int aac_asc_probe(const uint8_t *conf, uint32_t size, int *sample_rate,
+                         int *channels) {
+  int object_type, freq_index, chan_conf;
+
+  if (size < 2) return IAMF_ERR_BAD_ARG;
+
+  object_type = conf[0] >> 3;
+  freq_index = (conf[0] & 0x7) << 1 | conf[1] >> 7;
+
+  if (freq_index == 0xf) {
+    /* 28 bit escape frequency, outside the IAMF AAC-LC constraint. Fall back
+     * to letting the decoder infer everything from the AudioSpecificConfig. */
+    return IAMF_ERR_BAD_ARG;
+  }
+  if (freq_index == 0x0 || freq_index > 12) return IAMF_ERR_BAD_ARG;
+
+  chan_conf = (conf[1] >> 3) & 0xf;
+  if (chan_conf > 7) return IAMF_ERR_BAD_ARG;
+
+  if (object_type != 2)
+    warn("aac: audio object type %d, AAC-LC (2) expected", object_type);
+
+  *sample_rate = def_aac_sample_rates[freq_index - 1];
+  *channels = chan_conf;
+  return IAMF_OK;
+}
+
+static void aac_asc_set_layout(AVChannelLayout *layout, int channels) {
+  switch (channels) {
+    case 1: av_channel_layout_default(layout, 1); break;
+    case 2: av_channel_layout_default(layout, 2); break;
+    case 3: av_channel_layout_from_mask(layout, AV_CH_LAYOUT_2_1); break;
+    case 4: av_channel_layout_from_mask(layout, AV_CH_LAYOUT_QUAD); break;
+    case 5: av_channel_layout_from_mask(layout, AV_CH_LAYOUT_5POINT0_BACK); break;
+    case 6: av_channel_layout_from_mask(layout, AV_CH_LAYOUT_5POINT1_BACK); break;
+    default: av_channel_layout_default(layout, channels); break;
+  }
+}
+
+/* Decode one IAMF audio substream into its region of the planar 16 bit buffer.
+ * Returns the number of samples per channel written, or an IAMF error code. */
+static int aac_decode_one_stream(aac_ms_decoder_t *st, int i,
+                                 const uint8_t *data, uint32_t size,
+                                 aac_pcm_sample_t *out, int *fs,
+                                 int *channels) {
+  AVCodecContext *avctx = st->avctx[i];
+  AVFrame *frame = st->frame;
+  AVPacket *pkt = 0;
+  int written = 0;
+  int ret = 0;
+
+  if (data) {
+    pkt = av_packet_alloc();
+    if (!pkt) return IAMF_ERR_ALLOC_FAIL;
+    /* av_new_packet() appends AV_INPUT_BUFFER_PADDING_SIZE, which FFmpeg bit
+     * readers are allowed to touch past the payload; the IAMF audio frame
+     * buffer carries no such padding, so the packet owns a copy. */
+    if (av_new_packet(pkt, (int)size) < 0) {
+      av_packet_free(&pkt);
+      return IAMF_ERR_ALLOC_FAIL;
+    }
+    memcpy(pkt->data, data, size);
+    ret = avcodec_send_packet(avctx, pkt);
+    av_packet_free(&pkt);
+    if (ret < 0) {
+      if (ret == AVERROR(EAGAIN)) return IAMF_ERR_BUFFER_TOO_SMALL;
+      error("stream %d : fail to submit aac packet, err %d", i, ret);
+      return IAMF_ERR_INVALID_PACKET;
+    }
+  } else {
+    ret = avcodec_send_packet(avctx, NULL);
+    if (ret < 0 && ret != AVERROR(EAGAIN) && ret != AVERROR_EOF) {
+      error("stream %d : flush failed, err %d", i, ret);
+      return IAMF_ERR_INTERNAL;
+    }
+  }
+
+  for (;;) {
+    const int nch_pending = *channels;
+    int nch, nb;
+    aac_pcm_sample_t *dst;
+
+    ret = avcodec_receive_frame(avctx, frame);
+    if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF || ret < 0) break;
+
+    nch = frame->ch_layout.nb_channels;
+    if (nch <= 0) nch = avctx->ch_layout.nb_channels;
+    if (nch <= 0) nch = i < st->coupled_streams ? 2 : 1;
+
+    nb = frame->nb_samples;
+    if (nb > def_max_aac_frame_size) {
+      warn("frame size %d , is larger than %u", nb,
+           (unsigned)def_max_aac_frame_size);
+      nb = def_max_aac_frame_size;
+    }
+    if (nb <= 0) {
+      av_frame_unref(frame);
+      continue;
+    }
+
+    if (frame->format != AV_SAMPLE_FMT_FLTP) {
+      error("stream %d : unsupported output sample format %d", i,
+            frame->format);
+      av_frame_unref(frame);
+      return IAMF_ERR_INTERNAL;
+    }
+    if (nch > 8) {
+      /* AVFrame::data only carries MAX_AV_PLANES plane pointers. */
+      error("stream %d : %d channels exceeds the plane array", i, nch);
+      av_frame_unref(frame);
+      return IAMF_ERR_INTERNAL;
+    }
+
+    dst = out + (size_t)written * nch_pending;
+    aac_copy_frame_planes(dst, frame, nb, nch);
+
+    written += nb;
+    *fs = nb;
+    *channels = nch;
+
+    if (!st->probed) {
+      st->probed = 1;
+      st->delay = nb;
+      warn("aac backend=ffmpeg stream %d : sampleRate %d frameSize %d "
+           "channels %d outputDelay %d",
+           i, avctx->sample_rate, nb, nch, st->delay);
+    }
+    av_frame_unref(frame);
+
+    /* One IAMF audio frame in is one access unit: stop after the first frame
+     * so the caller's per-substream regions keep the same layout as fdk's. */
+    if (data) break;
+  }
+
+  if (!written) {
+    /* Nothing came out - the flush case, or a bitstream underrun. Emit a
+     * silent frame so the sample accounting matches the fdk backend. */
+    int nb = *fs > 0 ? *fs : (int)def_max_aac_frame_size;
+    int nch = *channels > 0 ? *channels : 1;
+    memset(out, 0, sizeof(aac_pcm_sample_t) * (size_t)nb * (size_t)nch);
+    written = nb;
+  }
+
+  return written;
+}
+
+static int aac_multistream_decode_native(
+    aac_ms_decoder_t *st, uint8_t *buffer[], uint32_t size[], void *pcm,
+    int frame_size, func_aac_copy_channel_out_t copy_channel_out) {
+  aac_pcm_sample_t *out = (aac_pcm_sample_t *)pcm;
+  int fs = frame_size;
+  int channels = 1;
+
+  (void)copy_channel_out;
+
+  for (int i = 0; i < st->streams; ++i) {
+    int region_channels = i < st->coupled_streams ? 2 : 1;
+    int n;
+
+    trace("stream %d", i);
+    channels = region_channels;
+    n = aac_decode_one_stream(st, i, buffer[i], buffer[i] ? size[i] : 0, out,
+                              &fs, &channels);
+    if (n < 0) return n;
+    out += n * channels;
+  }
+
+  if (st->delay < 0 && fs > 0) st->delay = fs;
+
+  return fs;
+}
+
+aac_ms_decoder_t *aac_multistream_decoder_open(uint8_t *config, uint32_t size,
+                                               int streams, int coupled_streams,
+                                               uint32_t flags, int *error) {
+  aac_ms_decoder_t *st = 0;
+  AVCodecContext **avctx = 0;
+  const AVCodec *decoder = 0;
+  uint8_t *mono_conf = 0;
+  int ret = 0;
+  int i;
+
+  if (!config || !size || streams < 1) {
+    ret = IAMF_ERR_BAD_ARG;
+    goto end;
+  }
+
+  /* Ask for the clean-room decoder by name and refuse anything else: the whole
+   * point of this backend is to not carry FDK-AAC, and AV_CODEC_ID_AAC also
+   * has a libfdk-aac wrapper in some FFmpeg builds. */
+  decoder = avcodec_find_decoder_by_name("aac");
+  if (!decoder || decoder->id != AV_CODEC_ID_AAC) {
+    error("native ffmpeg aac decoder not available");
+    ret = IAMF_ERR_INVALID_STATE;
+    goto end;
+  }
+
+  mono_conf = def_malloc(uint8_t, size);
+  st = def_mallocz(aac_ms_decoder_t, 1);
+  avctx = def_mallocz(AVCodecContext *, streams);
+  if (!mono_conf || !st || !avctx) {
+    ret = IAMF_ERR_ALLOC_FAIL;
+    def_free(avctx);
+    goto end;
+  }
+
+  st->flags = flags;
+  st->streams = streams;
+  st->coupled_streams = coupled_streams;
+  st->delay = -1;
+  st->avctx = avctx;
+  st->frame = av_frame_alloc();
+  if (!st->frame) {
+    ret = IAMF_ERR_ALLOC_FAIL;
+    goto end;
+  }
+
+  memcpy(mono_conf, config, size);
+  aac_config_set_channels(mono_conf, size, 1);
+
+  for (i = 0; i < streams; ++i) {
+    const uint8_t *asc = i < coupled_streams ? config : mono_conf;
+    int sample_rate = 0, asc_channels = 0;
+    AVCodecContext *c;
+
+    c = avcodec_alloc_context3(decoder);
+    if (!c) {
+      ret = IAMF_ERR_INVALID_STATE;
+      break;
+    }
+    st->avctx[i] = c;
+
+    c->extradata =
+        (uint8_t *)av_malloc(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!c->extradata) {
+      ret = IAMF_ERR_ALLOC_FAIL;
+      break;
+    }
+    memcpy(c->extradata, asc, size);
+    memset(c->extradata + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    c->extradata_size = (int)size;
+    /* AAC-LC: the AudioSpecificConfig is the only configuration source and the
+     * IAMF substream payload is a raw GAS access unit (no ADTS, no AU header),
+     * the same TT_MP4_RAW configuration the fdk backend is given. */
+    c->codec_type = AVMEDIA_TYPE_AUDIO;
+
+    if (aac_asc_probe(asc, size, &sample_rate, &asc_channels) == IAMF_OK &&
+        asc_channels > 0) {
+      c->sample_rate = sample_rate;
+      aac_asc_set_layout(&c->ch_layout, asc_channels);
+    }
+    /* Ask for float planar explicitly: the native decoder also advertises
+     * S32P, and the plane conversion below assumes float. */
+    c->request_sample_fmt = AV_SAMPLE_FMT_FLTP;
+
+    if (avcodec_open2(c, decoder, NULL) < 0) {
+      error("aac config raw error for stream %d", i);
+      ret = IAMF_ERR_INTERNAL;
+      break;
+    }
+  }
+
+end:
+  def_free(mono_conf);
+
+  if (ret < 0) {
+    if (error) *error = ret;
+    if (st) aac_multistream_decoder_close(st);
+    st = 0;
+  }
+
+  return st;
+}
+
+int aac_multistream_decode(aac_ms_decoder_t *st, uint8_t *buffer[],
+                           uint32_t size[], void *pcm, uint32_t frame_size) {
+  /* The planar layout is applied by aac_copy_frame_planes() while reading the
+   * AVFrame, so no copy callback is needed here; the argument is kept only to
+   * mirror the fdk backend's internal shape. */
+  if (st->flags & ck_audio_frame_planar)
+    return aac_multistream_decode_native(st, buffer, size, pcm,
+                                         (int)frame_size, NULL);
+  error("flags is 0x%x, is not implmeneted.", st->flags);
+  return IAMF_ERR_UNIMPLEMENTED;
+}
+
+void aac_multistream_decoder_close(aac_ms_decoder_t *st) {
+  if (st) {
+    if (st->avctx) {
+      for (int i = 0; i < st->streams; ++i) {
+        if (st->avctx[i]) avcodec_free_context(&st->avctx[i]);
+      }
+      free(st->avctx);
+    }
+    if (st->frame) av_frame_free(&st->frame);
+    free(st);
+  }
+}
+
+int aac_multistream_decoder_get_delay(aac_ms_decoder_t *st) {
+  return st->delay < 0 ? 0 : st->delay;
+}
+#endif /* IAMF_AAC_BACKEND_FFMPEG */
+#endif /* CONFIG_AAC_CODEC */
