<Project>
  <!--
    R2R 排除表：PublishReadyToRunExclude 是 Item（不是 Property），用 -p: 传会被忽略，
    只能从 imports 钩子注入。配合 -p:CustomAfterMicrosoftCommonTargets=<本文件> 使用。

    目的：复刻 A2 口径（仅 LakeUI + FFF.Player 参与 R2R），用于 O4 × A2 可加性测量。

    2026-11-04 清理（136 号盘点 #4，123 §7.2 判定）：删除全部 20 条原生 DLL 条目
    （ass/avcodec/avfilter/avformat/avutil/bluray/brotli/bz2/charset/freetype/fribidi/
    harfbuzz/iconv/libpng/libxml2/swresample/swscale/udfread/z）——R2R 只处理托管
    程序集，原生 DLL 条目从来无效。保留托管程序集 11 条。
  -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="FFF.Native.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="SharpGen.Runtime.COM.dll" />
    <PublishReadyToRunExclude Include="SharpGen.Runtime.dll" />
    <PublishReadyToRunExclude Include="Vortice.Direct2D1.dll" />
    <PublishReadyToRunExclude Include="Vortice.Direct3D11.dll" />
    <PublishReadyToRunExclude Include="Vortice.DirectComposition.dll" />
    <PublishReadyToRunExclude Include="Vortice.DirectX.dll" />
    <PublishReadyToRunExclude Include="Vortice.DXGI.dll" />
    <PublishReadyToRunExclude Include="Vortice.Mathematics.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
  </ItemGroup>
</Project>
