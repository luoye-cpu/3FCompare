+        Assert.Equal(expected, g8);
+        Assert.Equal(expected, b8);
+    }
+
+    [Theory]
+    // 旧实现 v*255 会给出 64 / 128 / 255 / 255，与这里的期望相差 24 / 5 / 87 / 25
