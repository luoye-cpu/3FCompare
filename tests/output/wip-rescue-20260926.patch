+    [InlineData(0.5f, 123)]
+    [InlineData(1.0f, 168)]
+    [InlineData(2.0f, 230)]
+    public void Display8Bit_Hdr_MapsViaLinearLight(float v, int expected)
+    {
+        ColorNormalizer.ToDisplay8Bit(v, v, v, 1f, bitDepth: 16, hdr: true,
+            out var r8, out _, out _, out _);
+        Assert.Equal(expected, r8);
