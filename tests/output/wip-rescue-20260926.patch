+diff --git a/FFF.Native/3FP/Api/FFF.Player.Api.h b/FFF.Native/3FP/Api/FFF.Player.Api.h
+index 1b98594..f119db6 100644
+--- a/FFF.Native/3FP/Api/FFF.Player.Api.h
