+-        NoteOffPumpPresent("handoff-timeout");
+-        return PresentTimedTextOnPump();
++        NotePumpOwnedPresentExcluded("handoff-timeout");
++        return FFFResult::DeviceFailure;
+     }
+     return pumpHandoffResult_;
+ }
