# 内核（FFF_Project，已解除 submodule 跟踪）
# 整个目录不入库：第三方源码 + 构建产物，依赖 tools/构建全部.ps1 重新获取/构建。
# 基线钉死在 tools/构建全部.ps1 的 $KernelBaselineSha；
# 历史补丁留档于 tools/patches/*.patch（入库跟踪，但不自动重放，详见该目录 README）。
third_party/fff_project/

# 测试媒体目录规范（testmedia/）：
#   media/  测试视频素材（*.mp4 等实际媒体文件，体积大不入库）
#   tmp/    临时产物（截图/pid/selftest 输出等，可随时删除）
#   tools/  测试辅助小工具（enumtest 等，入库跟踪）
#   *.ps1   测试操作脚本（入库跟踪）
testmedia/media/
testmedia/tmp/
testmedia/tools/*/bin/
testmedia/tools/*/obj/

# 发布产物（NativeAOT + 第三方 DLL，190+ MB）
publish/

# 旧 AI 工具的会话临时产物（plan / 快照），内容已被 docs/ 与各里程碑实现覆盖
.zcode/

# 一次性 UI 自动化/调试脚本：硬编码屏幕坐标与进程号，不可复用（已移入 tools/debug/）
tools/debug/
tools/_*.py
tools/_*.txt

# 参考用的第三方 UI 库（GPL/付费双授权，仅作视觉参考，不参与构建）
third_party/LakeUI/

# 本机 git 对象库损坏恢复时的临时备份（勿提交）
_corrupt_pack_backup/

# WorkBuddy 工作记忆（本机 agent 日志与项目约定，不入库；文件保留在磁盘）
.workbuddy-ai/

# 内核基线追溯记录（tools/构建全部.ps1 生成，发布门禁据此校验产物内核 == 发布基线）
# 是本机构建产物，每台机器/每次构建都可能不同，不入库。
.3fc_kernel_sha

# 注意：.3fc_kernel_baseline.bundle 是**有意入库**的（约 2MB），不要加到这里。
# 它是内核基线归档（当前：分支 3fc/integrate-issue7 @ 0d5856e +
# tag 3fcompare-kernel-2026.9.18.2，回滚点 3fcompare-kernel-2026.9.18.1），
# 上游 Lake1059/FFF_Project 不含 3FCompare 扩展，没有它换机器就无法复现构建。
# 恢复方式：git clone .3fc_kernel_baseline.bundle third_party/fff_project
#
# ⚠ 重建时必须把 HEAD 一起打进 bundle，否则克隆后 "remote HEAD refers to
#   nonexistent ref"，工作区不会 checkout（得到空目录）。旧 bundle 就缺 HEAD。
#   git -C third_party/fff_project bundle create <输出路径> \
#     HEAD 3fc/integrate-issue7 3fcompare/zoom-viewport-cover \
#     3fcompare-kernel-2026.9.18.2 3fcompare-kernel-2026.9.18.1

# ── 调试残留（历次实机自测/崩溃排查产生，勿入库；2026-09-15 第二轮审查补）──
/_*.log
/_dumps/
/_crash_*.txt
/_probe.txt
/_newsha.txt
/_pscheck.txt
/crash_trace_*.log

# ── 本地工作目录（验证/评审/转储的临时产物，勿入库；2026-09-18 追踪审查补）──
# 这些目录累计约 3.6 GB（.review_pr 独占 2.1 GB），此前未忽略 ⇒ 每次 git status 都冒出来。
/.3fc_dumps/
/.3fc_verify_*
/.review_pr/
/.verify_halffix/
/.verify_pr_e2e/
/.verify_rpe/

# ── 根目录杂项（外部资料 / 驱动日志目录，勿入库）──
/_hdr.png
/lunarlake_factsheet.pdf
/NVIDIA Corporation/

# 崩溃取证运行产物（工具本身入库，运行数据不入库）
tools/crashscope/runs/
tools/crashscope/scenes/

# 清理隔离区（一次性验证工程与历史产物，可确认后删除）
_quarantine_*/
